{
  "name": "course-helper",
  "version": "0.3.0",
  "private": true,
  "description": "学习通与雨课堂浏览器课程播放助手",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Geng0214/CourseHelper.git"
  },
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "build:userscript": "node scripts/build-userscript.mjs",
    "test": "node --test tests/*.test.mjs",
    "package": "node scripts/package.mjs && npm run build:userscript",
    "package:source": "npm run build:userscript && node scripts/package-source.mjs",
    "verify": "npm run check && npm test && npm run package"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "jsdom": "31.0.0",
    "typescript": "7.0.2"
  }
}
